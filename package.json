{
  "name": "courtside",
  "version": "1.0.0",
  "private": true,
  "description": "Local library of basketball game torrents from sport-video.org.ua, stored in SQLite",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server.mjs",
    "prune": "node --no-warnings=ExperimentalWarning scripts/prune.mjs",
    "build:app": "bash scripts/build-mac-app.sh"
  },
  "dependencies": {
    "webtorrent": "^2.8.5"
  },
  "overrides": {
    "uint8-util": "2.2.5"
  }
}
