# Dependencies
node_modules/

# Local data: only the library database and cached poster images are tracked.
data/*
!data/games.db
!data/img/
data/img/*
!data/img/*.jpg
!data/img/*.jpeg
!data/img/*.png
!data/img/*.webp

# Never commit media or torrent files, wherever they end up
*.torrent
*.mkv
*.mp4
*.m4v
*.ts
*.avi
*.mov
*.webm

# SQLite temp files (the app doesn't use WAL, but just in case)
*.db-shm
*.db-wal
*.db-journal

# OS / editor
.DS_Store
*.log
